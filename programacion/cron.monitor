CRON_TZ=America/Bogota
*/5 * * * * monitor cd /opt/portocaribe-monitor && /usr/bin/python3 -m monitor run --config /etc/monitor/monitor.toml >> data/logs/cron.log 2>&1
59 23 * * * monitor cd /opt/portocaribe-monitor && /usr/bin/python3 -m monitor export --config /etc/monitor/monitor.toml >> data/logs/cron.log 2>&1
