[Unit]
Description=Portal de Clientes PortoCaribe (demostración)
After=network.target

[Service]
Type=simple
User=portal
Group=portal
WorkingDirectory=/opt/portal
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m portal --config /etc/portal/portal.toml
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/portal

[Install]
WantedBy=multi-user.target
